# ---- Database ----
# Local Postgres example. Replace with your own connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/active24?schema=public"

# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Auth / JWT ----
# Use long random strings in production (e.g. `openssl rand -hex 48`).
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ---- CORS ----
# Comma-separated list of allowed origins for the SPA (used when not behind the dev proxy).
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"

# ---- Seed default passwords (optional override) ----
SEED_MANAGER_PASSWORD="Manager@123"
SEED_ADMIN_PASSWORD="Admin@123"
SEED_CASHIER_PASSWORD="Cashier@123"
