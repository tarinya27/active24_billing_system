# Production / staging environment — copy to `.env` at repo root for docker-compose ONLY.
# Local dev uses backend/.env — see start-local.ps1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=active24

JWT_ACCESS_SECRET=change-me-use-openssl-rand-hex-48
JWT_REFRESH_SECRET=change-me-use-openssl-rand-hex-48

# Public URL of the SPA (comma-separated if multiple)
CORS_ORIGINS=http://localhost:8080,https://billing.active24.lk

HTTP_PORT=8080

# Seed passwords (first deploy only — run: docker compose run --rm backend npm run db:seed)
SEED_MANAGER_PASSWORD=Manager@123
SEED_ADMIN_PASSWORD=Admin@123
SEED_CASHIER_PASSWORD=Cashier@123
